# NetForge controller environment — copy to /etc/netforge/controller.env and edit.
# Keep this file root-owned and mode 0600 — it contains bearer tokens.

# Token clients use to reach the controller (the CLI's NETFORGE_CONTROLLER_TOKEN).
NETFORGE_CONTROLLER_TOKEN=change-me-controller-secret

# Token the controller presents to agents. MUST equal every agent's
# NETFORGE_AGENT_TOKEN or probe fan-out fails with 401.
NETFORGE_AGENT_TOKEN=change-me-shared-agent-secret

# SQLite state file. Ensure the directory is writable by the service user
# (see ReadWritePaths in netforge-controller.service).
NETFORGE_CONTROLLER_DB=/var/lib/netforge/controller.db
