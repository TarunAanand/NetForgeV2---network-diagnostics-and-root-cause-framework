# NetForge agent environment — copy to /etc/netforge/agent.env and edit.
# systemd EnvironmentFile values are literal (no shell expansion, no quotes needed).
# Keep this file root-owned and mode 0600 — it contains a bearer token.

# Unique id for this agent (must match how you register it with the controller).
NETFORGE_AGENT_ID=agent-db-1

# Bearer token the controller presents when probing this agent.
# MUST be identical on every agent and on the controller (NETFORGE_AGENT_TOKEN).
NETFORGE_AGENT_TOKEN=change-me-shared-agent-secret

# Optional: comma-separated allow-list for targeted probes (icmp/tcp/dns/traceroute).
# Leave empty to allow any target.
NETFORGE_ALLOWED_TARGETS=10.0.0.0/24,1.1.1.1,8.8.8.8

# Optional: topology tags. The part after NETFORGE_TAG_ is lowercased.
NETFORGE_TAG_site=lab
NETFORGE_TAG_rack=r2
